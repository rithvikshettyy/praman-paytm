# WhatsApp (Meta Cloud API). Copy to whatsapp/.env; the backend reads it at start.
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Webhook: <public URL>/api/whatsapp/webhook, subscribed to "messages".
# Permanent system-user token (the 24-hour test token expires).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# App secret: signs every inbound webhook. Unsigned or forged requests are refused.
WA_APP_SECRET=
# Any string you choose; type the same one into Meta's webhook setup.
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0
