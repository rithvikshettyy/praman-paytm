# Copy to backend/.env and fill in real values. Never commit .env.

# --- Sarvam (all inference) -------------------------------------------------
# https://dashboard.sarvam.ai
# The key stays server-side. The frontend calls the backend, never Sarvam.
SARVAM_API_KEY=

# Swap the chat model in one line if the lineup moves.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
# Set to glm5.2 (or gemma4) to use Sarvam's open-weight models on /v2. That
# endpoint is beta and key-whitelisted; the backend falls back to
# SARVAM_CHAT_MODEL if it is not enabled for your key.
SARVAM_ANALYSIS_MODEL=sarvam-105b
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TRANSLATE_MODEL_COLLOQUIAL=mayura:v1
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TIMEOUT_SECONDS=120
SARVAM_MAX_TOKENS_CEILING=4096

# Doc AI limits. 10 req/min and 10 pages/job are the documented caps; the
# defaults sit just inside them so bursts queue instead of returning 429.
DOC_AI_RATE_LIMIT_PER_MIN=9
DOC_AI_MAX_PAGES_PER_JOB=10

# Doc AI job polling for synchronous extraction.
DOC_AI_TIMEOUT_SECONDS=180
DOC_AI_POLL_SECONDS=3

# --- Extraction -------------------------------------------------------------
# Fields read with less confidence than this are asked, never assumed.
CONFIDENCE_GATE=0.8
# Demo safety net: serve backend/tests/fixtures/*_demo.json (labelled example
# data) instead of calling Doc AI. Leave false for real documents.
USE_DOC_FIXTURES=false

# --- Store ------------------------------------------------------------------
# MongoDB: local (docker run -d -p 27017:27017 mongo:7) or an Atlas mongodb+srv:// string
MONGO_URI=
MONGO_DB=

# --- Respondents ------------------------------------------------------------
# Legal name used to address drafts when the distributor owes the answer.
# Insurer and lender names are read from her documents instead.
DISTRIBUTOR_LEGAL_NAME=
# How the Distributor Console headline names the distributor ("Of N cases, X needed <name>").
# Defaults to "the distributor".
DISTRIBUTOR_SHORT_NAME=

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Webhook: <public URL>/api/whatsapp/webhook, subscribed to "messages".
# Permanent system-user token (the 24-hour test token expires).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# App secret: signs every inbound webhook. Unsigned or forged requests are refused.
WA_APP_SECRET=
# Any string you choose; type the same one into Meta's webhook setup.
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0

# --- n8n (delivery and follow-up; see ../n8n/README.md) -------------------------
# Production URL of the "Letter from Praman" webhook. Blank = sending is off.
N8N_DISPATCH_URL=
# Shared secret, sent both ways in the x-praman-secret header. Callbacks are refused without it.
N8N_SECRET=
# Public address n8n can reach this API on (a tunnel in development).
PUBLIC_BASE_URL=
# Demo only: treat this many days as already passed when a response window is checked. 0 = real calendar.
N8N_DEMO_DAYS_AHEAD=0
# Premium reminders (see ../n8n/README.md): production URL of the "Premium reminder" webhook, the address
# reminders go to, and how many days before the due date to remind (comma separated). Blank URL or address = off.
N8N_REMINDER_URL=
REMINDER_EMAIL=
REMINDER_DAYS_BEFORE=7,1

# --- Coverage questions (RAG) ---------------------------------------------
# default = MiniLM (downloads ~80 MB once, on first ingest); hashing = offline, word-matching only.
RAG_EMBEDDINGS=default
# Minutes between background refreshes of the news layer (data/news_sources.yaml). 0 = off.
NEWS_REFRESH_MINUTES=0

# --- App --------------------------------------------------------------------
# Browser origins allowed to call the API: the frontend dev server only.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=209715200

# Web search for "Find a policy" (Firecrawl). Blank = off.
FIRECRAWL_API_KEY=

# Policy search reads only these sites (the distributor's insurance pages)
POLICY_SEARCH_DOMAINS=
